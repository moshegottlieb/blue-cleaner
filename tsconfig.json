{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "paths": {
      "#/*": ["./src/*"]
    },
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}